# انسخ الملف ده باسم .env.local وحط فيه بيانات حساب الخدمة (Service Account)
# من غير المتغيرات دي، الداشبورد بتشتغل على بيانات تجريبية وهمية.

# الرقم اللي في رابط الشيت: docs.google.com/spreadsheets/d/<ده>/edit
GOOGLE_SHEET_ID=

# من ملف JSON بتاع حساب الخدمة: client_email
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# من نفس الملف: private_key (بين علامتين تنصيص، وسيب \n زي ما هي)
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# رابط الموقع بعد الرفع، عشان صورة المشاركة تظهر في واتساب وغيره (اختياري؛ على Vercel بيتحدد لوحده)
# NEXT_PUBLIC_SITE_URL=https://refd-dashboard.vercel.app

# أسماء الشيتات لو مختلفة جدًا عن الأصلية (اختياري؛ المطابقة بتتجاهل الهمزات والمسافات)
# SHEET_TAB_FAMILY=فحوصات التحقق الصحي للأسرة
# SHEET_TAB_CHILDREN=فحص الاطفال قبل الاستلام
# SHEET_TAB_PSYCH=الفحص النفسي

# السيرفر يطلب من Google مرة كل كام ثانية كحد أقصى (اختياري، الافتراضي 30)
# SHEET_CACHE_SECONDS=30

# الصفحة المفتوحة تتحدث كل كام ثانية (اختياري، الافتراضي 60)
# NEXT_PUBLIC_REFRESH_SECONDS=60
