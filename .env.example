# Copy this file to .env.local and fill in the service account details
# Without these variables, the dashboard runs on fake demo data.

# The ID in the sheet URL: docs.google.com/spreadsheets/d/<this>/edit
GOOGLE_SHEET_ID=

# From the service account JSON file: client_email
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# From the same file: private_key (in double quotes, keep the \n as is)
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Site URL after deploy, so the share image shows in WhatsApp and others (optional; set automatically on Vercel)
# NEXT_PUBLIC_SITE_URL=https://refd-dashboard.vercel.app

# Tab names if they differ a lot from the originals (optional; matching ignores hamza and spaces)
# SHEET_TAB_FAMILY=<family health check tab name>
# SHEET_TAB_CHILDREN=<children pre-receipt check tab name>
# SHEET_TAB_PSYCH=<psychological check tab name>

# How often, at most, the server requests Google, in seconds (optional, default 30)
# SHEET_CACHE_SECONDS=30

# How often an open page refreshes, in seconds (optional, default 60)
# NEXT_PUBLIC_REFRESH_SECONDS=60
